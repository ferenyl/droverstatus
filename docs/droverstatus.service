# Example systemd user unit for the single-file build (dist/droverstatus).
#
#   npm run build:dist && cp dist/droverstatus ~/.local/bin/
#   cp docs/droverstatus.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now droverstatus
#   journalctl --user -u droverstatus -f
#
# Needs node, zellij, claude, jq and git on PATH; adjust Environment=PATH if they live elsewhere.
#
# First login: until a password is set, the login token is in the runtime dir, not in the journal:
#   cat $XDG_RUNTIME_DIR/droverstatus/bootstrap-token
# Log in on the login page, then set a password in Settings. The token file is deleted once a password exists.
# Forgot the password: droverstatus reset-password (same user). Set one from the shell: droverstatus set-password.
# Behind an HTTPS reverse proxy, add --trust-proxy <proxy IP or CIDR> to ExecStart (see README, Authentication).

[Unit]
Description=droverstatus dashboard for drover corrals
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Environment=PORT=4177
# Environment=DROVER_SH=%h/.claude/plugins/cache/<marketplace>/<plugin>/<version>/skills/drover/scripts/drover.sh
ExecStart=%h/.local/bin/droverstatus
Restart=on-failure
RestartSec=5
# Corral actions (new, revive, close, send, kill, flush) run through the systemd user manager in their
# own scope, so corrals never live in this unit: stopping, restarting or removing it leaves them alone.
# KillMode=process is a safety net in case DROVER_DETACH=0 is set.
KillMode=process
# Hardening. Corrals are started outside this unit, so none of this reaches zellij or the agents
# (unless DROVER_DETACH=0). droverstatus itself only reads drover state and runs drover.sh via systemd-run.
#NoNewPrivileges=yes
#ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
