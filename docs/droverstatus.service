# Example systemd user unit for the single-file build (dist/droverstatus).
#
#   npm run build:dist && cp dist/droverstatus ~/.local/bin/
#   cp docs/droverstatus.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now droverstatus
#   journalctl --user -u droverstatus -f
#
# Needs node, zellij, claude, jq and git on PATH; adjust Environment=PATH if they live elsewhere.

[Unit]
Description=droverstatus dashboard for drover corrals
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Environment=PORT=4177
# Environment=DROVER_SH=%h/.claude/plugins/cache/<marketplace>/<plugin>/<version>/skills/drover/scripts/drover.sh
ExecStart=%h/.local/bin/droverstatus
Restart=on-failure
RestartSec=5
# Hardening. Agents started through drover.sh run inside this unit's sandbox and need to write to
# your projects, drover state and zellij sockets, so only /usr, /boot and /etc are made read-only
# (ProtectSystem=full). Use ProtectSystem=strict + ReadWritePaths= only if you list every project dir.
# NOTE: NoNewPrivileges and ProtectSystem are inherited by everything started from here (zellij and
# the agents), so sudo/setuid tools and writes to /usr, /boot and /etc fail inside agents. They are
# opt-in: uncomment if you accept that.
#NoNewPrivileges=yes
#ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
