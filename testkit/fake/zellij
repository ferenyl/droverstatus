# Fake zellij: `list-sessions` prints $DROVER_ROOT/.zellij-sessions (edit live to flip liveness).
case "${1:-}" in
  list-sessions) cat "${DROVER_ROOT:?}/.zellij-sessions" 2>/dev/null; exit 0 ;;
  *) echo "fake zellij: unsupported $*" >&2; exit 1 ;;
esac
