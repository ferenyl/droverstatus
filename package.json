{
  "name": "droverstatus",
  "version": "0.1.0",
  "description": "Local web dashboard for drover corrals, agents and tasks",
  "license": "GPL-3.0-only",
  "author": "Ferenyl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w web",
    "build:dist": "npm run build && node scripts/build-dist.mjs",
    "start": "[ -d web/dist ] || npm run build; npm start -w server",
    "test": "vitest run && npm test -w web",
    "typecheck": "tsc -b server web shared",
    "test:e2e": "bash testkit/e2e.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
